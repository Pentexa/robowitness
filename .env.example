RW_META_API_KEY=
RW_META_BASE_URL=
RW_META_MODEL=
RW_AI_MODE=offline
RW_AI_TIMEOUT_SECONDS=20
RW_AI_MAX_RETRIES=2
RW_AI_MAX_INPUT_CHARS=16000
RW_AI_MAX_OUTPUT_TOKENS=1000
RW_AI_MAX_CALLS_PER_WORKFLOW=3
RW_AI_MAX_ESTIMATED_COST_USD=1.00
RW_DB_PATH=./artifacts/robowitness.sqlite3
RW_ARTIFACTS_DIR=./artifacts
RW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Yerel politika (kendi kodun): varsayılan kapalı. "on" yaparsan backend/app/policies/local/
# altındaki SENİN yazdığın Python politikalar simülasyonda çalışır. Yapay zekâ kodu KESİNLİKLE yasak.
RW_ALLOW_LOCAL_POLICY=off
# Enterprise API anahtarları (boş = açık yerel mod): "anahtar:rol:calisma-alani;anahtar2:viewer:ws"
# Roller: admin (her şey) > editor (okuma+yazma) > viewer (sadece okuma)
RW_API_KEYS=
# Aday yasası: shared (varsayılan, tüm ölçülmüş sonuçlar) | mpc (doğrulanmış MPC-lite) | mpc-crowd (kalabalık) | stateful/waypoint (deneysel)
RW_CANDIDATE_LAW=shared
# Sensör modeli: legacy (varsayılan) | beam (24 ışınlı LiDAR benzeri, deneysel)
RW_SENSOR_MODEL=legacy
NEXT_PUBLIC_RW_API_URL=http://localhost:8000
