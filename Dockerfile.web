# RoboWitness web (Next.js production build)
FROM node:26-alpine AS build
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web ./
ARG NEXT_PUBLIC_RW_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_RW_API_URL=$NEXT_PUBLIC_RW_API_URL
RUN npm run build

FROM node:26-alpine
WORKDIR /web
COPY --from=build /web ./
EXPOSE 3000
CMD ["npm", "run", "start"]
